{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "knowledge-server",
	// account_id removed for security - use CLOUDFLARE_ACCOUNT_ID env var
	"main": "src/index.ts",
	"compatibility_date": "2026-02-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	/**
	 * Secrets (set via `npx wrangler secret put <n>`):
	 *   GITHUB_WEBHOOK_SECRET, GITHUB_TOKEN, GITHUB_REPO, AI_SEARCH_API_TOKEN, CF_ACCOUNT_ID
	 */
	"kv_namespaces": [
		{ "binding": "SYNC_STATE", "id": "6b98b7a4d10746cf90cbfcdc559597ee" }
	],
	"workflows": [
		{
			"name": "knowledge-sync-workflow",
			"binding": "SYNC_WORKFLOW",
			"class_name": "KnowledgeSyncWorkflow"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	},
	"dev": {
		"port": 8788
	},
	"r2_buckets": [
		{
			"bucket_name": "superbenefit-knowledge",
			"binding": "KNOWLEDGE",
			"remote": true
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 100, "period": 60 }
		}
	]
}
